{
  "datasets": [
    {
      "data_root": "/workspace/dataset",
      "dataset_type": "video_references",
      "target_resolution": [ 480, 854 ],
      "auto_frame_buckets": true,

      "elements": [
        {
          "name": "object",
          "suffixes": [ "_object.png" ],
          "required": true,
          "processors": {
            "vae": { "repeat": 4, "position": 0 },
            "clip": { "position": 0 }
          }
        },
        {
          "name": "background",
          "suffixes": [ "_background.png" ],
          "required": false,
          "processors": {
            "vae": { "repeat": 1, "position": 2 },
            "clip": { "position": 1 }
          }
        },
        {
          "name": "captions",
          "suffixes": [ ".txt" ],
          "required": true,
          "processors": {
            "text": { "position": 0, "repeat": 1 }
          }
        },
        {
          "name": "video",
          "suffixes": [ ".mp4" ],
          "required": true,
          "processors": {
            "target": { "position": 0, "repeat": 1 }
          }
        }
      ],

      "processors": {
        "target": {
          "modality": "VIDEO",
          "resolution": [ 480, 854 ],
          "preprocessor": "letterbox",
          "batch_size": 1,
          "model": "vae",
          "output": "target_latents"
        },
        "vae": {
          "modality": "VIDEO",
          "resolution": [ 480, 854 ],
          "preprocessor": "letterbox",
          "model": "vae",
          "batch_size": 1,
          "concatenate_mask": true,
          "frame_conditioning": "full",
          "output": "vae_latents"
        },
        "clip": {
          "modality": "IMAGE",
          "resolution": [ 512, 512 ],
          "preprocessor": "letterbox",
          "model": "image_encoder",
          "padding_color": 1.0,
          "trim_alpha": true,
          "alpha_threshold": 0.1,
          "padding_buffer": 8,
          "batch_size": 1,
          "output": "clip_latents"
        },
        "text": {
          "modality": "TEXT",
          "model": "text_encoder",
          "max_length": 128,
          "padding": "max_length",
          "truncation": true,
          "batch_size": 1,
          "remove_common_llm_caption_prefixes": true,
          "output": "text_latents"
        }
      }


    }
  ]
}